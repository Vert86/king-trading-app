<xml xmlns="https://developers.google.com/blockly/xml" is_dbot="true" collection="false">
  <variables>
    <variable id="var-vwap-proxy">vwap_proxy</variable>
    <variable id="var-rsi">rsi</variable>
    <variable id="var-last-close">last_close</variable>
    <variable id="var-was-oversold">was_oversold</variable>
    <variable id="var-was-overbought">was_overbought</variable>
    <variable id="var-total-profit">total_profit</variable>
  </variables>
  <block type="trade_definition" id="vr-trade-def" deletable="false" x="0" y="0">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="vr-market" deletable="false" movable="false">
        <field name="MARKET_LIST">forex</field>
        <field name="SUBMARKET_LIST">major_pairs</field>
        <field name="SYMBOL_LIST">frxEURUSD</field>
        <next>
          <block type="trade_definition_tradetype" id="vr-tradetype" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">callput</field>
            <field name="TRADETYPE_LIST">callput</field>
            <next>
              <block type="trade_definition_contracttype" id="vr-contracttype" deletable="false" movable="false">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="trade_definition_candleinterval" id="vr-candleinterval" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="vr-restartbuysell" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="vr-restartonerror" deletable="false" movable="false">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="vr-init-oversold">
        <field name="VAR" id="var-was-oversold">was_oversold</field>
        <value name="VALUE">
          <block type="logic_boolean" id="vr-init-oversold-val">
            <field name="BOOL">FALSE</field>
          </block>
        </value>
        <next>
          <block type="variables_set" id="vr-init-overbought">
            <field name="VAR" id="var-was-overbought">was_overbought</field>
            <value name="VALUE">
              <block type="logic_boolean" id="vr-init-overbought-val">
                <field name="BOOL">FALSE</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="vr-init-total-profit">
                <field name="VAR" id="var-total-profit">total_profit</field>
                <value name="VALUE">
                  <shadow type="math_number" id="vr-init-total-profit-val">
                    <field name="NUM">0</field>
                  </shadow>
                </value>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="vr-tradeoptions">
        <mutation xmlns="http://www.w3.org/1999/xhtml" has_first_barrier="false" has_second_barrier="false" has_prediction="false"></mutation>
        <field name="DURATIONTYPE_LIST">m</field>
        <value name="DURATION">
          <shadow type="math_number" id="vr-duration-val">
            <field name="NUM">15</field>
          </shadow>
        </value>
        <value name="AMOUNT">
          <shadow type="math_number_positive" id="vr-amount-val">
            <field name="NUM">1</field>
          </shadow>
        </value>
      </block>
    </statement>
  </block>

  <block type="before_purchase" id="vr-before-purchase" deletable="false" x="0" y="400">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="sma_statement" id="vr-vwap-statement">
        <field name="VARIABLE" id="var-vwap-proxy">vwap_proxy</field>
        <statement name="STATEMENT">
          <block type="input_list" id="vr-vwap-input-list" deletable="false" movable="false">
            <value name="INPUT_LIST">
              <block type="ohlc_values" id="vr-vwap-ohlc">
                <field name="OHLCFIELD_LIST">close</field>
                <field name="CANDLEINTERVAL_LIST">60</field>
              </block>
            </value>
            <next>
              <block type="period" id="vr-vwap-period" deletable="false" movable="false">
                <value name="PERIOD">
                  <block type="math_number" id="vr-vwap-period-val">
                    <field name="NUM">20</field>
                  </block>
                </value>
              </block>
            </next>
          </block>
        </statement>
        <next>
          <block type="rsi_statement" id="vr-rsi-statement">
            <field name="VARIABLE" id="var-rsi">rsi</field>
            <statement name="STATEMENT">
              <block type="input_list" id="vr-rsi-input-list" deletable="false" movable="false">
                <value name="INPUT_LIST">
                  <block type="ohlc_values" id="vr-rsi-ohlc">
                    <field name="OHLCFIELD_LIST">close</field>
                    <field name="CANDLEINTERVAL_LIST">60</field>
                  </block>
                </value>
                <next>
                  <block type="period" id="vr-rsi-period" deletable="false" movable="false">
                    <value name="PERIOD">
                      <block type="math_number" id="vr-rsi-period-val">
                        <field name="NUM">14</field>
                      </block>
                    </value>
                  </block>
                </next>
              </block>
            </statement>
            <next>
              <block type="variables_set" id="vr-set-last-close">
                <field name="VAR" id="var-last-close">last_close</field>
                <value name="VALUE">
                  <block type="lists_getIndex" id="vr-last-close-get">
                    <mutation statement="false" at="false"></mutation>
                    <field name="MODE">GET</field>
                    <field name="WHERE">LAST</field>
                    <value name="VALUE">
                      <block type="ohlc_values" id="vr-last-close-ohlc">
                        <field name="OHLCFIELD_LIST">close</field>
                        <field name="CANDLEINTERVAL_LIST">60</field>
                      </block>
                    </value>
                  </block>
                </value>
                <next>
                  <block type="controls_if" id="vr-if-mark-oversold">
                    <value name="IF0">
                      <block type="logic_compare" id="vr-cmp-oversold">
                        <field name="OP">LT</field>
                        <value name="A">
                          <block type="variables_get" id="vr-get-rsi-1">
                            <field name="VAR" id="var-rsi">rsi</field>
                          </block>
                        </value>
                        <value name="B">
                          <block type="math_number" id="vr-oversold-threshold">
                            <field name="NUM">30</field>
                          </block>
                        </value>
                      </block>
                    </value>
                    <statement name="DO0">
                      <block type="variables_set" id="vr-set-oversold-true">
                        <field name="VAR" id="var-was-oversold">was_oversold</field>
                        <value name="VALUE">
                          <block type="logic_boolean" id="vr-oversold-true-val">
                            <field name="BOOL">TRUE</field>
                          </block>
                        </value>
                        <next>
                          <block type="variables_set" id="vr-set-overbought-false-1">
                            <field name="VAR" id="var-was-overbought">was_overbought</field>
                            <value name="VALUE">
                              <block type="logic_boolean" id="vr-overbought-false-val-1">
                                <field name="BOOL">FALSE</field>
                              </block>
                            </value>
                          </block>
                        </next>
                      </block>
                    </statement>
                    <next>
                      <block type="controls_if" id="vr-if-mark-overbought">
                        <value name="IF0">
                          <block type="logic_compare" id="vr-cmp-overbought">
                            <field name="OP">GT</field>
                            <value name="A">
                              <block type="variables_get" id="vr-get-rsi-2">
                                <field name="VAR" id="var-rsi">rsi</field>
                              </block>
                            </value>
                            <value name="B">
                              <block type="math_number" id="vr-overbought-threshold">
                                <field name="NUM">70</field>
                              </block>
                            </value>
                          </block>
                        </value>
                        <statement name="DO0">
                          <block type="variables_set" id="vr-set-overbought-true">
                            <field name="VAR" id="var-was-overbought">was_overbought</field>
                            <value name="VALUE">
                              <block type="logic_boolean" id="vr-overbought-true-val">
                                <field name="BOOL">TRUE</field>
                              </block>
                            </value>
                            <next>
                              <block type="variables_set" id="vr-set-oversold-false-1">
                                <field name="VAR" id="var-was-oversold">was_oversold</field>
                                <value name="VALUE">
                                  <block type="logic_boolean" id="vr-oversold-false-val-1">
                                    <field name="BOOL">FALSE</field>
                                  </block>
                                </value>
                              </block>
                            </next>
                          </block>
                        </statement>
                        <next>
                          <block type="controls_if" id="vr-if-long-entry">
                            <value name="IF0">
                              <block type="logic_operation" id="vr-and-long">
                                <field name="OP">AND</field>
                                <value name="A">
                                  <block type="logic_operation" id="vr-and-long-inner">
                                    <field name="OP">AND</field>
                                    <value name="A">
                                      <block type="logic_compare" id="vr-cmp-price-above-vwap">
                                        <field name="OP">GT</field>
                                        <value name="A">
                                          <block type="variables_get" id="vr-get-last-close-1">
                                            <field name="VAR" id="var-last-close">last_close</field>
                                          </block>
                                        </value>
                                        <value name="B">
                                          <block type="variables_get" id="vr-get-vwap-1">
                                            <field name="VAR" id="var-vwap-proxy">vwap_proxy</field>
                                          </block>
                                        </value>
                                      </block>
                                    </value>
                                    <value name="B">
                                      <block type="logic_compare" id="vr-cmp-rsi-above-50-long">
                                        <field name="OP">GT</field>
                                        <value name="A">
                                          <block type="variables_get" id="vr-get-rsi-3">
                                            <field name="VAR" id="var-rsi">rsi</field>
                                          </block>
                                        </value>
                                        <value name="B">
                                          <block type="math_number" id="vr-fifty-1">
                                            <field name="NUM">50</field>
                                          </block>
                                        </value>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                                <value name="B">
                                  <block type="variables_get" id="vr-get-was-oversold">
                                    <field name="VAR" id="var-was-oversold">was_oversold</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                            <statement name="DO0">
                              <block type="variables_set" id="vr-reset-oversold-after-buy">
                                <field name="VAR" id="var-was-oversold">was_oversold</field>
                                <value name="VALUE">
                                  <block type="logic_boolean" id="vr-reset-oversold-val">
                                    <field name="BOOL">FALSE</field>
                                  </block>
                                </value>
                                <next>
                                  <block type="purchase" id="vr-purchase-call">
                                    <field name="PURCHASE_LIST">CALL</field>
                                  </block>
                                </next>
                              </block>
                            </statement>
                            <next>
                              <block type="controls_if" id="vr-if-short-entry">
                                <value name="IF0">
                                  <block type="logic_operation" id="vr-and-short">
                                    <field name="OP">AND</field>
                                    <value name="A">
                                      <block type="logic_operation" id="vr-and-short-inner">
                                        <field name="OP">AND</field>
                                        <value name="A">
                                          <block type="logic_compare" id="vr-cmp-price-below-vwap">
                                            <field name="OP">LT</field>
                                            <value name="A">
                                              <block type="variables_get" id="vr-get-last-close-2">
                                                <field name="VAR" id="var-last-close">last_close</field>
                                              </block>
                                            </value>
                                            <value name="B">
                                              <block type="variables_get" id="vr-get-vwap-2">
                                                <field name="VAR" id="var-vwap-proxy">vwap_proxy</field>
                                              </block>
                                            </value>
                                          </block>
                                        </value>
                                        <value name="B">
                                          <block type="logic_compare" id="vr-cmp-rsi-below-50-short">
                                            <field name="OP">LT</field>
                                            <value name="A">
                                              <block type="variables_get" id="vr-get-rsi-4">
                                                <field name="VAR" id="var-rsi">rsi</field>
                                              </block>
                                            </value>
                                            <value name="B">
                                              <block type="math_number" id="vr-fifty-2">
                                                <field name="NUM">50</field>
                                              </block>
                                            </value>
                                          </block>
                                        </value>
                                      </block>
                                    </value>
                                    <value name="B">
                                      <block type="variables_get" id="vr-get-was-overbought">
                                        <field name="VAR" id="var-was-overbought">was_overbought</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                                <statement name="DO0">
                                  <block type="variables_set" id="vr-reset-overbought-after-sell">
                                    <field name="VAR" id="var-was-overbought">was_overbought</field>
                                    <value name="VALUE">
                                      <block type="logic_boolean" id="vr-reset-overbought-val">
                                        <field name="BOOL">FALSE</field>
                                      </block>
                                    </value>
                                    <next>
                                      <block type="purchase" id="vr-purchase-put">
                                        <field name="PURCHASE_LIST">PUT</field>
                                      </block>
                                    </next>
                                  </block>
                                </statement>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>

  <block type="after_purchase" id="vr-after-purchase" x="780" y="400">
    <statement name="AFTERPURCHASE_STACK">
      <block type="math_change" id="vr-change-total-profit">
        <field name="VAR" id="var-total-profit">total_profit</field>
        <value name="DELTA">
          <shadow type="math_number" id="vr-change-delta-shadow">
            <field name="NUM">1</field>
          </shadow>
          <block type="read_details" id="vr-read-profit">
            <field name="DETAIL_INDEX">4</field>
          </block>
        </value>
        <next>
          <block type="controls_if" id="vr-if-stop-conditions">
            <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>
            <value name="IF0">
              <block type="logic_operation" id="vr-or-stop">
                <field name="OP">OR</field>
                <value name="A">
                  <block type="logic_compare" id="vr-cmp-loss-stop">
                    <field name="OP">LTE</field>
                    <value name="A">
                      <block type="variables_get" id="vr-get-total-profit-1">
                        <field name="VAR" id="var-total-profit">total_profit</field>
                      </block>
                    </value>
                    <value name="B">
                      <block type="math_number" id="vr-loss-threshold-val">
                        <field name="NUM">-20</field>
                      </block>
                    </value>
                  </block>
                </value>
                <value name="B">
                  <block type="logic_compare" id="vr-cmp-profit-stop">
                    <field name="OP">GTE</field>
                    <value name="A">
                      <block type="variables_get" id="vr-get-total-profit-2">
                        <field name="VAR" id="var-total-profit">total_profit</field>
                      </block>
                    </value>
                    <value name="B">
                      <block type="math_number" id="vr-profit-threshold-val">
                        <field name="NUM">20</field>
                      </block>
                    </value>
                  </block>
                </value>
              </block>
            </value>
            <statement name="ELSE">
              <block type="trade_again" id="vr-trade-again"></block>
            </statement>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>
